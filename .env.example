# DealDesk Local demo configuration. Copy to .env (git-ignored) and edit.
# Placeholders only: never commit real endpoints, credentials, or model weights.

# Bind to loopback for the single-user demo.
DEALDESK_HOST=127.0.0.1
DEALDESK_PORT=8000

# scripted     = labeled scripted wording over the real local tools (no model needed)
# local_model  = optional: word answers with a local OpenAI-compatible endpoint you run yourself.
#                Cloud hosts are refused; there is no cloud fallback.
# Live OpenClaw/NemoClaw + Nemotron inference does not use these settings: OpenClaw calls the
# DealDesk tools through openclaw/skills/dealdesk-local/SKILL.md.
DEALDESK_MODE=scripted

# Only used when DEALDESK_MODE=local_model.
DEALDESK_LLM_BASE_URL=http://127.0.0.1:8001/v1
DEALDESK_LLM_MODEL=<local-model-name>
DEALDESK_LLM_API_KEY=
DEALDESK_LLM_TIMEOUT_SECONDS=60
# Extra private-network hostnames allowed for the model endpoint, comma-separated.
DEALDESK_LLM_ALLOWED_HOSTS=

# Injected demo clock (quote expires 2026-11-15). Use "system" for the real date.
DEALDESK_DEMO_DATE=2026-10-25

# Scheduled watcher for data/runtime/incoming_feeds; 0 disables it.
DEALDESK_WATCH_INTERVAL_SECONDS=5

# Local runtime state (SQLite and the watched feed folder); git-ignored.
DEALDESK_STATE_DIR=data/runtime

# Separate Astro viewer configuration (packages/viewer).
ASTRO_TELEMETRY_DISABLED=1
DEALDESK_DEV_ACTOR=u-sofia
PRICING_BASE_URL=http://127.0.0.1:8001
PRICING_MODE=fixture
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_MODE=off

# Slack review cards (integrations/slack). Copy to integrations/slack/.env (git-ignored).
# Slack only receives an opaque review ID; deal details stay in the local viewer.
SLACK_BOT_TOKEN=xoxb-<placeholder>
SLACK_APP_TOKEN=xapp-<placeholder>
DEAL_ROOM_CHANNEL=<channel-id>
DEALDESK_VIEWER_URL=http://127.0.0.1:4321/
