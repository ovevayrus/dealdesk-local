{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string"
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "docId": {
            "type": "string"
          },
          "docHash": {
            "type": "string"
          },
          "docTitle": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "chunkIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "page": {
            "type": [
              "number",
              "null"
            ]
          },
          "passage": {
            "type": "string"
          },
          "effectiveDate": {
            "type": "string"
          },
          "classification": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "restricted"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string"
          },
          "withheld": {
            "type": "boolean"
          },
          "missing": {
            "type": "boolean"
          }
        },
        "required": [
          "docId",
          "docHash",
          "docTitle",
          "section",
          "page",
          "passage",
          "effectiveDate",
          "classification",
          "rank",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "runId",
    "hits"
  ],
  "additionalProperties": false
}
