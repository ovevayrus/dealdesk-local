{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string"
    },
    "dealId": {
      "type": "string"
    },
    "accountId": {
      "type": "string"
    },
    "actor": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "seller",
            "manager",
            "admin"
          ]
        },
        "accountIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "userId",
        "role",
        "accountIds"
      ],
      "additionalProperties": false
    },
    "sku": {
      "type": "string"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deliveryStart": {
      "type": "string"
    },
    "deliveryEnd": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "scopeLocations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "termMonths": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "paymentTerms": {
      "type": "string"
    },
    "proposedDiscountPct": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "const": "USD"
    },
    "quoteExpiry": {
      "type": "string"
    }
  },
  "required": [
    "requestId",
    "dealId",
    "accountId",
    "actor",
    "sku",
    "quantity",
    "deliveryStart",
    "deliveryEnd",
    "destination",
    "scopeLocations",
    "termMonths",
    "paymentTerms",
    "proposedDiscountPct",
    "currency",
    "quoteExpiry"
  ],
  "additionalProperties": false
}
