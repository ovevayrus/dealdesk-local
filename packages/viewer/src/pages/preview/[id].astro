---
import "../../styles/app.css";
import { randomUUID } from "node:crypto";
import { getDb } from "../../lib/db.ts";
import { getActor, checkAccountScope } from "../../lib/session.ts";
import { buildCustomerDraft } from "../../lib/render-pack.ts";
import ActorBanner from "../../components/ActorBanner.astro";
import type { QuoteVersion } from "@dealdesk/contracts";

const { id } = Astro.params;
const url = new URL(Astro.request.url);

// Role switcher handling
const actorQuery = url.searchParams.get("actor");
if (actorQuery) {
  Astro.cookies.set("dd_actor", actorQuery, { path: "/", httpOnly: false });
  url.searchParams.delete("actor");
  return Astro.redirect(url.pathname + (url.search ? url.search : ""));
}

const actor = getActor(Astro.request);

const db = getDb();
const stmt = db.prepare(`
  SELECT quote_id, version, payload, created_at
  FROM quote_versions
  WHERE quote_id = ?
  ORDER BY version DESC
  LIMIT 1
`);

const row = stmt.get(id) as any;

if (!row) {
  return new Response(`Quote ${id} not found`, { status: 404 });
}

const quoteVersion: QuoteVersion = JSON.parse(row.payload);

// Authorize account scope
if (!checkAccountScope(actor, quoteVersion.request.accountId)) {
  const runId = `r-${randomUUID()}`;
  return new Response(
    JSON.stringify({
      runId,
      error: {
        code: "FORBIDDEN_ACCOUNT",
        message: `Actor ${actor.userId} is not authorized for account ${quoteVersion.request.accountId}.`,
      },
    }),
    { status: 403, headers: { "Content-Type": "application/json" } }
  );
}

const customerDraft = buildCustomerDraft(quoteVersion);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Customer Proposal Draft — {quoteVersion.request.dealId}</title>
  </head>
  <body style="background: #f8fafc; color: #0f172a; padding: 2rem;">
    <div style="max-width: 800px; margin: 0 auto 1.5rem auto;">
      <ActorBanner />
      <div style="margin-top: 0.5rem;">
        <a href={`/quote/${quoteVersion.quoteId}?v=${quoteVersion.version}`} style="font-size: 0.85rem; color: #2563eb; text-decoration: none;">&larr; Back to Internal Deal Pack</a>
      </div>
    </div>

    <div style="max-width: 800px; margin: 0 auto; background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 2.5rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #0f172a; padding-bottom: 1.5rem; margin-bottom: 2rem;">
        <div>
          <h1 style="font-size: 1.75rem; font-weight: 700;">Commercial Proposal</h1>
          <p style="color: #64748b; font-size: 0.875rem; margin-top: 0.25rem;">
            Prepared for: <strong>{quoteVersion.request.accountId}</strong> &bull; Deal Reference: {quoteVersion.request.dealId}
          </p>
        </div>
        <div style="text-align: right;">
          <span style="display: inline-block; padding: 0.25rem 0.6rem; background: #e0f2fe; color: #0369a1; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">
            PROPOSAL DRAFT &bull; v{quoteVersion.version}
          </span>
          <p style="color: #64748b; font-size: 0.75rem; margin-top: 0.25rem;">
            Valid through: {customerDraft.quoteExpiry}
          </p>
        </div>
      </div>

      <!-- Commercial Terms -->
      <div style="margin-bottom: 2rem;">
        <h2 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem;">Summary of Commercial Terms</h2>
        <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
          <tbody>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 0.75rem 0; color: #64748b;">Total Contract Value</td>
              <td style="padding: 0.75rem 0; text-align: right; font-weight: 700; font-size: 1.15rem; color: #0f172a;">
                ${customerDraft.totalContractValue} <span style="font-size: 0.8rem; font-weight: 500; color: #64748b;">{customerDraft.currency}</span>
              </td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 0.75rem 0; color: #64748b;">Upfront Deployment Fee</td>
              <td style="padding: 0.75rem 0; text-align: right; font-weight: 600; color: #0f172a;">
                ${customerDraft.upfront} {customerDraft.currency}
              </td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 0.75rem 0; color: #64748b;">Recurring Service (Term Total)</td>
              <td style="padding: 0.75rem 0; text-align: right; font-weight: 600; color: #0f172a;">
                ${customerDraft.recurring} {customerDraft.currency}
              </td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 0.75rem 0; color: #64748b;">Scope Locations</td>
              <td style="padding: 0.75rem 0; text-align: right; font-weight: 600; color: #0f172a;">
                {customerDraft.scopeLocations} sites
              </td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 0.75rem 0; color: #64748b;">Deployment Destination</td>
              <td style="padding: 0.75rem 0; text-align: right; font-weight: 600; color: #0f172a;">
                {customerDraft.destination}
              </td>
            </tr>
            <tr>
              <td style="padding: 0.75rem 0; color: #64748b;">Service Term</td>
              <td style="padding: 0.75rem 0; text-align: right; font-weight: 600; color: #0f172a;">
                {customerDraft.termMonths} Months
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Scope & Commercial Narrative -->
      <div style="margin-bottom: 2rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 1.25rem;">
        <h3 style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.5rem; color: #334155;">
          Scope & Operational Overview
        </h3>
        <p style="font-size: 0.9rem; line-height: 1.6; color: #334155;">
          {customerDraft.explanation}
        </p>
      </div>

      <!-- Gating Notice -->
      <div style="background: #eff6ff; border-left: 4px solid #3b82f6; padding: 1rem; border-radius: 0 4px 4px 0;">
        <p style="font-size: 0.8rem; color: #1e40af; margin: 0;">
          <strong>Human Review Notice:</strong> This commercial proposal draft has been generated in accordance with DealDesk Local governance policies. Redacted customer projection verified with zero internal cost or margin leakage.
        </p>
      </div>
    </div>
  </body>
</html>
