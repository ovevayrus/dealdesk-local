---
import "../../styles/app.css";
import { randomUUID } from "node:crypto";
import { getDb } from "../../lib/db.ts";
import { getActor, getActors, checkAccountScope } from "../../lib/session.ts";
import { hydrateEvidence } from "../../lib/retrieval.ts";
import EvidencePanel from "../../components/EvidencePanel.astro";
import type { QuoteVersion } from "@dealdesk/contracts";

const { id } = Astro.params;
const url = new URL(Astro.request.url);

// Role switcher handling
const actorQuery = url.searchParams.get("actor");
if (actorQuery) {
  Astro.cookies.set("dd_actor", actorQuery, { path: "/", httpOnly: false });
  // Redirect to clean URL
  url.searchParams.delete("actor");
  return Astro.redirect(url.pathname + (url.search ? url.search : ""));
}

const actor = getActor(Astro.request);
const allActors = getActors();

const db = getDb();
const stmt = db.prepare(`
  SELECT quote_id, version, payload, created_at
  FROM quote_versions
  WHERE quote_id = ?
  ORDER BY version DESC
  LIMIT 1
`);

const row = stmt.get(id) as any;

if (!row) {
  return new Response(`Quote ${id} not found`, { status: 404 });
}

const quoteVersion: QuoteVersion = JSON.parse(row.payload);

// Authorize the quote itself per Spec 02 Fix 1
if (!checkAccountScope(actor, quoteVersion.request.accountId)) {
  const runId = `r-${randomUUID()}`;
  return new Response(
    JSON.stringify({
      runId,
      error: {
        code: "FORBIDDEN_ACCOUNT",
        message: `Actor ${actor.userId} is not authorized to access quote for account ${quoteVersion.request.accountId}.`,
      },
    }),
    {
      status: 403,
      headers: { "Content-Type": "application/json" },
    }
  );
}

// Hydrate evidence passing the actor to enforce classification authorization in SQL
const hydratedEvidence = hydrateEvidence(quoteVersion.evidence, actor);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quote {quoteVersion.quoteId} v{quoteVersion.version} — DealDesk Local</title>
  </head>
  <body>
    <div class="container">
      <div class="actor-banner">
        <div>
          Active Session: <strong>{actor.userId}</strong> ({actor.role}) &bull; Accounts: {actor.accountIds.join(", ")}
        </div>
        <div class="role-switch">
          Switch role:
          {allActors.map((a) => (
            <a href={`?actor=${a.userId}`}>
              {a.userId} ({a.role})
            </a>
          ))}
        </div>
      </div>

      <div class="header">
        <div>
          <h1>Deal Pack: {quoteVersion.quoteId} (v{quoteVersion.version})</h1>
          <p style="color: var(--text-muted); font-size: 0.875rem;">
            Account: <strong>{quoteVersion.request.accountId}</strong> &bull; Deal: {quoteVersion.request.dealId} &bull; Created: {quoteVersion.createdAt}
          </p>
        </div>
        <div>
          <span class={`badge`} style={`background-color: ${quoteVersion.approval.state === 'approved' ? 'var(--success)' : 'var(--warning)'}; color: white;`}>
            Status: {quoteVersion.approval.state} (v{quoteVersion.version})
          </span>
        </div>
      </div>

      <div class="panels-grid">
        <!-- Step 5 Milestone Evidence Panel -->
        <EvidencePanel evidence={hydratedEvidence} />

        <!-- Seed Deal Overview -->
        <div class="panel">
          <h2>Offer Overview</h2>
          <table class="data-table">
            <tbody>
              <tr>
                <td>Total Contract Value</td>
                <td class="numeric"><strong>${quoteVersion.economics.totalContractValue}</strong></td>
              </tr>
              <tr>
                <td>List Price</td>
                <td class="numeric">${quoteVersion.economics.listPrice}</td>
              </tr>
              <tr>
                <td>Discount</td>
                <td class="numeric">{quoteVersion.economics.discountPct}%</td>
              </tr>
              <tr>
                <td>Upfront / Recurring</td>
                <td class="numeric">${quoteVersion.economics.upfront} / ${quoteVersion.economics.recurring}</td>
              </tr>
              <tr>
                <td>Quantity & SKU</td>
                <td class="numeric">{quoteVersion.request.quantity} units &bull; {quoteVersion.request.sku}</td>
              </tr>
              <tr>
                <td>Scope & Term</td>
                <td class="numeric">{quoteVersion.request.scopeLocations} locations &bull; {quoteVersion.request.termMonths} months</td>
              </tr>
              <tr>
                <td>Validity Date</td>
                <td class="numeric">{quoteVersion.request.quoteExpiry}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </body>
</html>
