# DealDesk Local Environment Configuration
# Local-only runtime configuration for GB10 hardware (127.0.0.1 only)

# Pricing Service Integration
# PRICING_MODE: 'fixture' (default reference figures), 'fixture-shock', or unset for live HTTP
PRICING_MODE=fixture
PRICING_BASE_URL=http://127.0.0.1:8001

# Local Model Integration (Ollama / vLLM OpenAI-compatible endpoint)
# MODEL_MODE: 'off' (default deterministic template fallback) or 'live'
MODEL_MODE=off
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_NAME=meta-llama/Llama-3-8B-Instruct

# Default Development Actor (u-sofia, u-dana, u-admin)
DEALDESK_DEV_ACTOR=u-dana

# Astro Telemetry (Strictly disabled per local security rules)
ASTRO_TELEMETRY_DISABLED=1
